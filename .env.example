# Language model (portraits). Without the key and the model it is off.
# GIGACHAT_AUTH_KEY=
# GIGACHAT_MODEL=GigaChat-3-Ultra
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# GIGACHAT_CA_FILE=/path/to/russian_trusted_root_ca_pem.crt

# Local Qwen reports (Ollama): docker compose --profile ai up -d ollama
LOCAL_LLM_MODEL=qwen3:1.7b
