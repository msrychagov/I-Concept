{
  "type": "object",
  "properties": {
    "formation": {
      "type": "object",
      "description": "Как меняются представления студента о себе и что изменилось с прежнего эссе, 2–3 предложения",
      "properties": {
        "text": {
          "type": "string"
        },
        "quotes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/quote"
          }
        },
        "before": {
          "type": "array",
          "description": "Цитаты из прежнего эссе, 1–2; пусто, если прежнего нет",
          "items": {
            "$ref": "#/$defs/quote"
          }
        }
      },
      "required": [
        "text",
        "quotes",
        "before"
      ]
    },
    "moments": {
      "$ref": "#/$defs/paragraph",
      "description": "Качества и установки: убеждения, эмоции, ценности, восприятие своих возможностей, 3–4 предложения"
    },
    "environment": {
      "$ref": "#/$defs/paragraph",
      "description": "Отношение к ВУЦ, порядкам, занятиям, товарищам, 1–2 предложения"
    },
    "deeds": {
      "type": "array",
      "description": "Что студент сделал сам в ВУЦ и в учёбе сверх обычных обязанностей: проекты, научная работа, материалы, мероприятия, соревнования, поручения; сначала по своей инициативе или вместе с преподавателем; без семьи и обычных обязанностей; 0–3 пункта, часто 0",
      "items": {
        "$ref": "#/$defs/paragraph"
      }
    },
    "developed": {
      "type": "array",
      "description": "Что воспитал ВУЦ, 0–3 качества",
      "items": {
        "$ref": "#/$defs/paragraph"
      }
    },
    "strengthen": {
      "type": "array",
      "description": "Что ещё усилить и как, 2–3 пункта",
      "items": {
        "$ref": "#/$defs/paragraph"
      }
    },
    "teachersConclusion": {
      "$ref": "#/$defs/paragraph",
      "description": "Вывод о преподавателях: что удалось и что ещё сделать, 2–3 предложения; пусто, если в teachers никого нет"
    },
    "teachers": {
      "type": "array",
      "description": "Преподаватели и командиры, которых называет студент",
      "items": {
        "type": "object",
        "properties": {
          "position": {
            "type": "string",
            "enum": [
              "начальник ВУЦ",
              "заместитель начальника ВУЦ",
              "начальник кафедры",
              "начальник цикла",
              "куратор взвода",
              "преподаватель",
              "не указано"
            ]
          },
          "name": {
            "type": "string",
            "description": "Метка человека из ответов, например [человек 2]; пусто, если студент его не назвал"
          },
          "kind": {
            "type": "string",
            "enum": [
              "благодарность",
              "проблема",
              "упоминание"
            ]
          },
          "text": {
            "type": "string"
          },
          "quotes": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/quote"
            }
          }
        },
        "required": [
          "position",
          "name",
          "kind",
          "text",
          "quotes"
        ]
      }
    }
  },
  "required": [
    "formation",
    "moments",
    "environment",
    "deeds",
    "developed",
    "strengthen",
    "teachersConclusion",
    "teachers"
  ],
  "$defs": {
    "quote": {
      "type": "object",
      "properties": {
        "question": {
          "type": "string",
          "description": "Номер вопроса, например 1.2"
        },
        "quote": {
          "type": "string",
          "description": "Дословный кусок ответа, 3–30 слов"
        }
      },
      "required": [
        "question",
        "quote"
      ]
    },
    "paragraph": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "quotes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/quote"
          }
        }
      },
      "required": [
        "text",
        "quotes"
      ]
    }
  }
}
